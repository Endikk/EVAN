{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Gateway": {
    "SiteId": "site-tours",
    "GatewayId": "tours-01",
    "PublishIntervalMs": 1000,
    "BufferCapacity": 50000,
    "AllowWrites": false,
    "AuditFile": "audit/ecritures.jsonl",
    "PkiDirectory": "pki",
    "AllowedTestTargets": [],
    "Connections": [
      {
        "MachineId": "m-pv01",
        "Protocol": "opcua",
        "Parameters": {
          "endpoint": "opc.tcp://localhost:50000",
          "securite": "SignAndEncrypt",
          "publication": "250"
        },
        "Points": [
          { "PointId": "m-pv01.o1.tension", "Address": "ns=3;s=DipData", "Scale": 0.2, "Offset": 110 },
          { "PointId": "m-pv01.o2.decalage", "Address": "ns=3;s=PositiveTrendData", "Scale": 0.01, "Offset": 0.1 },
          { "PointId": "m-pv01.o4.vitesse", "Address": "ns=3;s=StepUp", "Scale": 0.05, "Offset": 150 }
        ]
      }
    ]
  },
  "Evan": {
    "Mqtt": {
      "Host": "localhost",
      "Port": 8883,
      "Tls": true,
      "CaFile": "../../infra/mosquitto/certs/ca.crt",
      "CertFile": "../../infra/mosquitto/certs/gateway.crt",
      "KeyFile": "../../infra/mosquitto/certs/gateway.key"
    }
  }
}
