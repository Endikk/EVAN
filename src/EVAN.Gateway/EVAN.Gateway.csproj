<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!--
    Passerelle edge installée dans l'usine (service Windows ou conteneur) : OPC UA, Modbus TCP, S7, JMF → MQTT.
    Ne dépend que du contrat (Core) et du transport (Messaging) : ni base, ni logique métier chez le client.
  -->
  <PropertyGroup>
    <UserSecretsId>evan-gateway</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" />
    <PackageReference Include="FluentModbus" />
    <PackageReference Include="S7netplus" />
    <!-- OpenTelemetry, exporté en OTLP seulement si OTEL_EXPORTER_OTLP_ENDPOINT est posée. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EVAN.Core\EVAN.Core.csproj" />
    <ProjectReference Include="..\EVAN.Messaging\EVAN.Messaging.csproj" />
  </ItemGroup>
</Project>
