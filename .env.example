# Copier en .env pour docker compose
EVAN_DB_PASSWORD=change-moi
# Assistant « Demander à EVAN » (Claude) : laisser vide pour une démo sans assistant ; le serveur MCP marche sans clé.
ANTHROPIC_API_KEY=
# Code d'accès de l'assistant et du serveur MCP pour les clients réseau (navigateurs via nginx, clients MCP) :
# 16 caractères au moins, par exemple `openssl rand -base64 24`. Vide : assistant et MCP refusés hors du poste du serveur.
EVAN_CODE_ACCES=
# Effort de l'assistant (low, medium, high, xhigh, max). Vide : celui du modèle. Voir docs/EXPLOITATION.md § 7.
EVAN_ASSISTANT_EFFORT=
# Installation d'EVAN pour l'entreprise : son organisation et son premier administrateur (POST /api/installation, voir
# README), possible une seule fois. 16 caractères au moins, par exemple `openssl rand -base64 24`. Vide : la route est
# fermée ; la vider une fois l'installation faite.
EVAN_CODE_INSTALLATION=
# Nom d'hôte du broker MQTT tel que les passerelles des usines le joignent (port 8883), repris dans le fichier de
# configuration de passerelle téléchargé depuis EVAN. Vide : l'exploitant le renseigne dans ce fichier.
EVAN_BROKER_PASSERELLES=

# Mise en ligne seulement (docker-compose.prod.yml, docs/DEPLOIEMENT.md) : à décommenter sur l'hôte, pas en local.
# COMPOSE_FILE fait prendre les deux fichiers à chaque commande docker compose.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# EVAN_DOMAINE=evan.exemple.fr
# Version des images GHCR : latest, ou un tag précis pour revenir à une version antérieure.
# EVAN_VERSION=latest
# Collecteur OpenTelemetry (traces, métriques, journaux de l'API). Absent : rien n'est exporté.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collecteur:4317
