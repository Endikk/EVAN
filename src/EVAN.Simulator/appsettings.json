{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Simulator": {
    "PeriodMs": 1000
  },
  "Evan": {
    "Mqtt": {
      "Host": "localhost",
      "Port": 8883,
      "Tls": true,
      "CaFile": "../../infra/mosquitto/certs/ca.crt",
      "CertFile": "../../infra/mosquitto/certs/simulator.crt",
      "KeyFile": "../../infra/mosquitto/certs/simulator.key"
    }
  }
}
